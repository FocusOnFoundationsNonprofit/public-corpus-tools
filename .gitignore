# Ignore any folder with "gitignore" in its name
**/*gitignore*/

# Python-specific ignore patterns
*.pyc
*.pyo
__pycache__/

# Python packaging ignore patterns
dist/
build/
*.egg-info/

# Virtual environment ignore patterns
.env
.venv
venv/
.venv*

env/
ms-graphrag/.env

# IDE-specific files and directories
# removed .vscode/ so workspace settings for cSpell.words would be included

# DB pattern
*-chroma-db/

# Large file zips for FloodLAMP Archive
**/_zip_*.zip

# API Keys and Access files
config.py
# Exclude all config.py files anywhere in the repository
**/config.py
gdrive_service_account_fofgeneral20_personal.json
credentials.json
credentials_new.json
gdrive_service_account.json
floodlamp-gdrive-jackie-cce56b4f953f.json
client_secret_*.*


# Exclude all PII files anywhere in the repository
**/PII*
**/pii*


